# ── Backend environment (copy to backend/.env and fill in) ──
# Never commit the real .env. Keep secrets out of git.

# Database — Supabase Postgres connection string (with pgvector enabled)
# e.g. postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# Auth — REQUIRED: set to a strong random secret (min 32 chars). App will not start without this.
JWT_SECRET=

# ── LLM providers ──
# Local (Ollama) inference has been removed: CPU Llama 3 was too slow and its
# Sinhala output was poor. Both the pipeline and query tiers now require a cloud
# provider. At least one of GEMINI_API_KEY or DEEPSEEK_API_KEY MUST be set.
# NOTE: this means OCR'd document text and user queries are sent to a third-party
# cloud LLM (see the PRIVACY TRADE-OFF note in llm_client.py and docs/SECURITY.md).

# LLM — DeepSeek (default cloud provider; used for both pipeline and query)
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# LLM — Gemini 2.5 Flash (optional upgrade; auto-preferred over DeepSeek when set)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set these after Vertex AI fine-tuning completes (see scripts/vertex_ai_finetune.sh)
GEMINI_TUNED_EXTRACTION_MODEL=
GEMINI_TUNED_QUERY_MODEL=

# OCR (Surya remote via Colab/ngrok); leave blank to use local fallback
COLAB_OCR_URL=

# PDF rendering (Poppler bin path), e.g. C:\poppler\bin
POPPLER_PATH=

# Email (SMTP) — used for verification / notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# URLs
APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Supabase Storage (added in Iter 0/1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# CORS — comma-separated list of allowed frontend origins (Iter 21)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting — requests per window (Iter 21)
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_ASK_QUERY=30
RATE_LIMIT_PROCESS_DOC=10
RATE_LIMIT_DEFAULT=120

# Session TTL in seconds — abandoned processing sessions are evicted after this (Iter 23)
SESSION_TTL_SECS=7200
